---
import { ClientRouter, fade } from "astro:transitions";
import { Font } from "astro:assets";
import "../styles/global.css";
import Seo, { type BreadcrumbItem } from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ArcaneControls from "../components/ArcaneControls.astro";
import LanguageMenu from "../components/LanguageMenu.astro";
import { DEFAULT_LANG, LANG_STORAGE_KEY, LANGUAGES, type Lang } from "../i18n/ui";
import { resolveLang, useTranslations } from "../i18n/utils";

export interface Props {
  title: string;
  description: string;
  lang?: Lang;
  alternateLocales?: Lang[];
  localePaths?: Partial<Record<Lang, string>>;
  immersive?: boolean;
  ogType?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  rawTitle?: boolean;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  lang = resolveLang(Astro.currentLocale),
  alternateLocales = [...LANGUAGES],
  localePaths,
  immersive = false,
  ogType = "website",
  pubDate,
  updatedDate,
  tags = [],
  rawTitle = false,
  ogImage,
  breadcrumbs = [],
} = Astro.props;

const t = useTranslations(lang);
const supportedLocales = [...LANGUAGES];
const nonDefaultLocales = LANGUAGES.filter((l) => l !== DEFAULT_LANG);
---

<!doctype html>
<html lang={lang} class:list={{ immersive }}>
  <head>
    <meta charset="UTF-8" />
    <Font cssVariable="--kejter" preload />
    <Font cssVariable="--amatic-sc" />
    <Font cssVariable="--morning-breeze" preload={[{ weight: 400, style: "normal" }]} />
    <Font cssVariable="--jetbrains-mono" />
    <Seo
      title={title}
      description={description}
      lang={lang}
      alternateLocales={alternateLocales}
      localePaths={localePaths}
      ogType={ogType}
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
      rawTitle={rawTitle}
      ogImage={ogImage}
      breadcrumbs={breadcrumbs}
    />
    <ClientRouter />
    <script
      is:inline
      define:vars={{
        supportedLocales,
        nonDefaultLocales,
        defaultLang: DEFAULT_LANG,
        langStorageKey: LANG_STORAGE_KEY,
      }}
    >
      (() => {
        try {
          const path = window.location.pathname;
          const currentFromPath = nonDefaultLocales.find(
            (code) => path === `/${code}` || path.startsWith(`/${code}/`),
          );

          if (!currentFromPath) {
            let savedLang = null;
            try {
              savedLang = localStorage.getItem(langStorageKey);
            } catch {}

            if (savedLang !== defaultLang) {
              const langs =
                navigator.languages && navigator.languages.length
                  ? navigator.languages
                  : [navigator.language || ""];
              const preferred = langs
                .map((l) => l.toLowerCase().split("-")[0])
                .find((code) => supportedLocales.includes(code));

              const targetLang =
                savedLang && nonDefaultLocales.includes(savedLang)
                  ? savedLang
                  : !savedLang && preferred && nonDefaultLocales.includes(preferred)
                    ? preferred
                    : null;

              if (targetLang) {
                const target = path === "/" ? `/${targetLang}/` : `/${targetLang}${path}`;
                window.location.replace(
                  target + window.location.search + window.location.hash,
                );
                return;
              }
            }
          }
        } catch {}

        const apply = () => {
          let savedTheme = null;
          let savedScale = null;
          let isCrystal = false;
          try {
            savedTheme = localStorage.getItem("theme");
            savedScale = localStorage.getItem("shlongeeland-scale-v2");
            isCrystal = localStorage.getItem("shlongeeland-crystal") === "true";
          } catch {}

          const isDark =
            savedTheme === "dark" ||
            (!savedTheme && window.matchMedia("(prefers-color-scheme: dark)").matches);

          if (savedScale) {
            document.documentElement.style.setProperty("--page-scale", savedScale);
          }

          document.documentElement.classList.toggle("dark", isDark);
          document.documentElement.classList.toggle("crystal", isCrystal);
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
    <slot name="head" />
  </head>
  <body class:list={{ immersive }}>
    <canvas
      class="wormhole-global-bg"
      data-space-wormhole
      transition:persist="wormhole"
      aria-hidden="true"
    ></canvas>
    <div class="viewport-vignette" transition:persist="vignette" aria-hidden="true"></div>

    {immersive ? (
      <main
        class="immersive-stage"
        transition:name="page-stage"
        transition:animate={fade({ duration: "0.45s" })}
      >
        <div class="home-arcane-dock">
          <ArcaneControls showCrystal={false} lang={lang} />
        </div>
        <slot />
        <LanguageMenu lang={lang} localePaths={localePaths} />
      </main>
    ) : (
      <div
        class="codex-shell"
        transition:name="page-stage"
        transition:animate={fade({ duration: "0.45s" })}
      >
        <div class="codex-sheet">
          <Header lang={lang} />
          <main class="site-main">
            <div class="page-scale-frame" data-page-scale-frame>
              <div class="page-scale-content" data-page-scale-content>
                <slot />
              </div>
            </div>
            <script is:inline>
              (() => {
                const frame = document.querySelector("[data-page-scale-frame]");
                const content = document.querySelector("[data-page-scale-content]");
                if (!frame || !content) return;
                let raw = null;
                try {
                  raw = localStorage.getItem("shlongeeland-scale-v2");
                } catch {}
                const parsed = raw ? parseFloat(raw) : NaN;
                const target = Number.isFinite(parsed)
                  ? Math.min(2.0, Math.max(0.7, parsed))
                  : 1.35;
                const baseWidth = content.offsetWidth;
                const availWidth = frame.clientWidth;
                if (!baseWidth || !availWidth) return;
                const scale = Math.min(target, availWidth / baseWidth);
                const offsetX = Math.max(0, (availWidth - baseWidth * scale) / 2);
                if (Math.abs(scale - 1) < 0.001) {
                  if (offsetX >= 0.5) content.style.transform = `translateX(${offsetX}px)`;
                } else {
                  content.style.transform = `translateX(${offsetX}px) scale(${scale})`;
                  frame.style.height = `${content.offsetHeight * scale}px`;
                }
              })();
            </script>
          </main>
          <Footer lang={lang} />
        </div>

        <LanguageMenu lang={lang} localePaths={localePaths} />

        <div id="scale-popover" class="scale-popover" data-scale-popover hidden>
          <div class="scale-popover__head">
            <label for="page-scale-slider">{t("scale.label")}</label>
            <strong data-scale-readout>1.35x</strong>
          </div>
          <input
            id="page-scale-slider"
            type="range"
            min="0.7"
            max="2.0"
            step="0.05"
            value="1.35"
            data-scale-slider
          />
          <div class="scale-popover__foot">
            <span>{t("scale.narrow")}</span>
            <button type="button" class="clear-btn scale-reset-btn" data-scale-reset>
              {t("scale.reset")}
            </button>
            <span>{t("scale.wide")}</span>
          </div>
        </div>
      </div>
    )}

    <script>
      import { mountArcaneControls } from "../scripts/arcane-controls";
      import { mountPageScaler } from "../scripts/page-scaler";
      import { mountCursorGlow } from "../scripts/cursor-glow";

      mountArcaneControls();
      mountPageScaler();
      mountCursorGlow();
    </script>

    <script>
      import { mountSpaceWormhole } from "../scripts/space-wormhole";

      mountSpaceWormhole();
    </script>
  </body>
</html>