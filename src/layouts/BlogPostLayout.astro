---
import BaseLayout from "./BaseLayout.astro";
import { LANGUAGES, type Lang } from "../i18n/ui";
import {
  formatDate,
  getTagLabel,
  localePath,
  resolveLang,
  useTranslations,
} from "../i18n/utils";

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  ogImage?: string;
  lang?: Lang;
  localePaths?: Partial<Record<Lang, string>>;
  alternateLocales?: Lang[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  ogImage,
  lang = resolveLang(Astro.currentLocale),
  localePaths,
  alternateLocales = [...LANGUAGES],
} = Astro.props;

const t = useTranslations(lang);
const formattedDate = formatDate(pubDate, lang);

const breadcrumbs = [
  { name: t("nav.home"), path: localePath(lang, "/") },
  { name: t("nav.blog"), path: localePath(lang, "/blog/") },
  { name: title, path: Astro.url.pathname },
];
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  localePaths={localePaths}
  alternateLocales={alternateLocales}
  ogType="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
  ogImage={ogImage}
  breadcrumbs={breadcrumbs}
>
  <article class="post-article">
    <header class="post-header">
      <p class="post-meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {updatedDate && (
          <span> · {t("blog.updated")} {formatDate(updatedDate, lang)}</span>
        )}
      </p>
      <h1>{title}</h1>
      <p class="post-description">{description}</p>
      {tags.length > 0 && (
        <ul class="tag-list" aria-label={t("nav.tags")}>
          {tags.map((tag) => (
            <li>
              <a class="tag-pill" href={localePath(lang, `/tags/${encodeURIComponent(tag)}/`)}>
                #{getTagLabel(lang, tag)}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>