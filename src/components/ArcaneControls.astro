---
import type { Lang } from "../i18n/ui";
import { resolveLang, useTranslations } from "../i18n/utils";

interface Props {
  showCrystal?: boolean;
  showScale?: boolean;
  lang?: Lang;
}

const { lang = resolveLang(Astro.currentLocale) } = Astro.props;
const t = useTranslations(lang);
---

<div class="arcane-controls">
  <button
    type="button"
    class="arcane-btn arcane-btn--motion"
    data-motion-toggle
    data-label-pause={t("controls.pauseAria")}
    data-label-resume={t("controls.resumeAria")}
    data-title-pause={t("controls.pauseTitle")}
    data-title-resume={t("controls.resumeTitle")}
    aria-label={t("controls.pauseAria")}
    aria-pressed="false"
    title={t("controls.pauseTitle")}
  >
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <g class="sigil-pause" fill="currentColor">
        <rect x="6.5" y="5" width="3.8" height="14" rx="1.2" />
        <rect x="13.7" y="5" width="3.8" height="14" rx="1.2" />
      </g>
      <g class="sigil-play" fill="currentColor">
        <path d="M8 5.4a1 1 0 0 1 1.52-.85l9.4 5.6a1 1 0 0 1 0 1.7l-9.4 5.6A1 1 0 0 1 8 16.6V5.4z" />
      </g>
    </svg>
  </button>

  <button
    type="button"
    class="arcane-btn arcane-btn--shuffle arcane-btn--aurora-orb"
    data-wormhole-shuffle
    aria-label={t("controls.shuffleAria")}
    title={t("controls.shuffleTitle")}
  >
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <defs>
        <linearGradient id="wormhole-orb-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--wormhole-warp, #24e6b5)" />
          <stop offset="50%" stop-color="var(--wormhole-base, #14d8e8)" />
          <stop offset="100%" stop-color="var(--wormhole-accent, #a66bff)" />
        </linearGradient>
      </defs>
      <circle cx="12" cy="12" r="10" fill="url(#wormhole-orb-grad)" />
    </svg>
  </button>

  <button
    type="button"
    class="arcane-btn arcane-btn--settings"
    data-settings-toggle
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-controls="settings-popover"
    aria-label={t("controls.settingsAria")}
    title={t("controls.settingsTitle")}
  >
    <svg class="arcane-settings-sigil" width="24" height="24" fill="none" viewBox="0 0 24 24">
      <path 
        class="settings-core"
        fill="currentColor"
        d="M12 9c.3 0 .74 2.26.74 2.26S15 11.7 15 12s-2.26.74-2.26.74S12.3 15 12 15s-.74-2.26-.74-2.26S9 12.3 9 12s2.26-.74 2.26-.74S11.7 9 12 9"
      />
      <path 
        class="settings-gear"
        fill="currentColor"
        d="M11.2 2.11a1 1 0 0 1 1.6 0l1.74 2.38c.23.3.6.46.97.4l2.91-.46a1 1 0 0 1 1.14 1.15l-.45 2.91a1 1 0 0 0 .4.97l2.38 1.73a1 1 0 0 1 0 1.62l-2.38 1.73a1 1 0 0 0-.4.97l.45 2.91a1 1 0 0 1-1.14 1.14l-2.91-.45a1 1 0 0 0-.97.4l-1.73 2.38a1 1 0 0 1-1.62 0l-1.73-2.38a1 1 0 0 0-.97-.4l-2.91.45a1 1 0 0 1-1.15-1.14l.46-2.91a1 1 0 0 0-.4-.97l-2.38-1.73a1 1 0 0 1 0-1.62l2.38-1.73a1 1 0 0 0 .4-.97l-.46-2.91a1 1 0 0 1 1.15-1.15l2.91.46a1 1 0 0 0 .97-.4zM12 6.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11"
      />
    </svg>
  </button>
</div>