---
import type { Lang } from "../i18n/ui";
import { resolveLang, useTranslations } from "../i18n/utils";

interface Props {
  showCrystal?: boolean;
  showScale?: boolean;
  lang?: Lang;
}

const { lang = resolveLang(Astro.currentLocale) } = Astro.props;
const t = useTranslations(lang);
---

<div class="arcane-controls">
  <button
    type="button"
    class="arcane-btn arcane-btn--motion"
    data-motion-toggle
    data-label-pause={t("controls.pauseAria")}
    data-label-resume={t("controls.resumeAria")}
    data-title-pause={t("controls.pauseTitle")}
    data-title-resume={t("controls.resumeTitle")}
    aria-label={t("controls.pauseAria")}
    aria-pressed="false"
    title={t("controls.pauseTitle")}
  >
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <g class="sigil-pause" fill="currentColor">
        <rect x="6.5" y="5" width="3.8" height="14" rx="1.2" />
        <rect x="13.7" y="5" width="3.8" height="14" rx="1.2" />
      </g>
      <g class="sigil-play" fill="currentColor">
        <path d="M8 5.4a1 1 0 0 1 1.52-.85l9.4 5.6a1 1 0 0 1 0 1.7l-9.4 5.6A1 1 0 0 1 8 16.6V5.4z" />
      </g>
    </svg>
  </button>

  <button
    type="button"
    class="arcane-btn arcane-btn--shuffle arcane-btn--aurora-orb"
    data-wormhole-shuffle
    aria-label={t("controls.shuffleAria")}
    title={t("controls.shuffleTitle")}
  >
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <circle
        class="orb-ring"
        cx="12" cy="12" r="9.5"
        fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2.5 2.2"
      />
      <defs>
        <linearGradient id="wormhole-orb-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--wormhole-base, #14d8e8)" />
          <stop offset="50%" stop-color="var(--wormhole-warp, #24e6b5)" />
          <stop offset="100%" stop-color="var(--wormhole-accent, #a66bff)" />
        </linearGradient>
      </defs>
      <circle cx="12" cy="12" r="5.5" fill="url(#wormhole-orb-grad)" />
      <circle cx="10.2" cy="10.2" r="1.4" fill="#ffffff" opacity="0.65" />
    </svg>
  </button>

  <button
    type="button"
    class="arcane-btn arcane-btn--settings"
    data-settings-toggle
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-controls="settings-popover"
    aria-label={t("controls.settingsAria")}
    title={t("controls.settingsTitle")}
  >
    <svg class="arcane-settings-sigil" viewBox="0 0 24 24" width="21" height="21" aria-hidden="true">
      <circle
        class="settings-ring"
        cx="12" cy="12" r="10.4"
        fill="none"
        stroke="currentColor"
        stroke-width="1"
        stroke-dasharray="2 2.4"
      />
      <g class="settings-gear" fill="none" stroke="currentColor" stroke-linecap="round">
        <circle cx="12" cy="12" r="5.2" stroke-width="1.75" />
        <path
          stroke-width="2.1"
          d="M12 4.3v1.6M12 18.1v1.6M4.3 12h1.6M18.1 12h1.6M6.7 6.7l1.2 1.2M16.1 16.1l1.2 1.2M17.3 6.7l-1.2 1.2M7.9 16.1l-1.2 1.2"
        />
      </g>
      <path
        class="settings-core"
        fill="currentColor"
        d="M12 9.1l.75 2.15L14.9 12l-2.15.75L12 14.9l-.75-2.15L9.1 12l2.15-.75z"
      />
    </svg>
  </button>
</div>