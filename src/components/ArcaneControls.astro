---
import ThemeIcon from "./ThemeIcon.astro";

interface Props {
  showCrystal?: boolean;
  showScale?: boolean;
}

const { showCrystal = true, showScale = showCrystal } = Astro.props;
---

<div class="arcane-controls">
  <ThemeIcon />

  {showCrystal && (
    <button
      type="button"
      class="arcane-btn arcane-btn--crystal"
      data-glass-toggle
      aria-label="Toggle crystal transparency"
      aria-pressed="false"
      title="Toggle crystal glass mode"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path
          d="M12 2L5 9.5 12 22l7-12.5L12 2zm0 2.9l4.1 4.4L12 18.2 7.9 9.3 12 4.9z"
          fill="currentColor"
        />
        <path d="M5 9.5h14" stroke="currentColor" stroke-width="1.2" opacity="0.65" />
      </svg>
    </button>
  )}

  {showScale && (
    <button
      type="button"
      class="arcane-btn arcane-btn--scale"
      data-scale-toggle
      aria-expanded="false"
      aria-controls="scale-popover"
      aria-label="Adjust page scale and width"
      title="Adjust page scale & width"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
      </svg>
    </button>
  )}

  <button
    type="button"
    class="arcane-btn arcane-btn--shuffle arcane-btn--aurora-orb"
    data-wormhole-shuffle
    aria-label="Shuffle wormhole colors"
    title="Shuffle wormhole colors"
  >
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <circle
        class="orb-ring"
        cx="12" cy="12" r="9.5"
        fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2.5 2.2"
      />
      <defs>
        <linearGradient id="wormhole-orb-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--wormhole-base, #14d8e8)" />
          <stop offset="50%" stop-color="var(--wormhole-warp, #24e6b5)" />
          <stop offset="100%" stop-color="var(--wormhole-accent, #a66bff)" />
        </linearGradient>
      </defs>
      <circle cx="12" cy="12" r="5.5" fill="url(#wormhole-orb-grad)" />
      <circle cx="10.2" cy="10.2" r="1.4" fill="#ffffff" opacity="0.65" />
    </svg>
  </button>
</div>