---
import type { Lang } from "../i18n/ui";
import { resolveLang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? resolveLang(Astro.currentLocale);
const isRu = lang === "ru";

const swirlLabel = isRu ? "Закручивание:" : "Swirl:";
const modeSeam = isRu ? "Режим: шов atan()" : "Mode: atan() Seam";
const modeSeamless = isRu ? "Режим: бесшовный (cosθ, sinθ)" : "Mode: Seamless (cosθ, sinθ)";
---

<div
  class="arcane-viz seam-viz"
  data-mode-seam={modeSeam}
  data-mode-seamless={modeSeamless}
>
  <div class="arcane-viz__controls">
    <label>
      {swirlLabel} <strong class="val-swirl">1.0</strong>
      <input type="range" class="slider-swirl" min="0" max="3" step="0.1" value="1" />
    </label>
    <button type="button" class="clear-btn seam-mode">{modeSeam}</button>
  </div>
  <canvas class="arcane-viz__canvas seam-canvas" width="520" height="170"></canvas>
</div>

<script>
  function initSeamViz() {
    document.querySelectorAll<HTMLElement>(".seam-viz").forEach((root) => {
      if (root.dataset.vizInit) return;
      root.dataset.vizInit = "true";

      const canvas = root.querySelector<HTMLCanvasElement>(".seam-canvas");
      const ctx = canvas?.getContext("2d");
      const slider = root.querySelector<HTMLInputElement>(".slider-swirl");
      const readout = root.querySelector<HTMLElement>(".val-swirl");
      const modeBtn = root.querySelector<HTMLButtonElement>(".seam-mode");
      if (!canvas || !ctx || !slider || !readout || !modeBtn) return;

      const labelSeam = root.dataset.modeSeam || "Mode: atan() Seam";
      const labelSeamless = root.dataset.modeSeamless || "Mode: Seamless (cosθ, sinθ)";
      let seamless = false;

      const w = canvas.width;
      const h = canvas.height;
      const count = w * h;
      const img = ctx.createImageData(w, h);
      const baseAngle = new Float32Array(count);
      const swirlWeight = new Float32Array(count);
      const depthPhase = new Float32Array(count);
      const vignette = new Float32Array(count);

      const cx = w / 2;
      const cy = h / 2;
      const invHalfH = 1 / (h * 0.5);

      for (let y = 0, i = 0; y < h; y++) {
        const dy = (y - cy) * invHalfH;
        for (let x = 0; x < w; x++, i++) {
          const dx = (x - cx) * invHalfH;
          const dist = Math.max(Math.hypot(dx, dy), 0.05);
          baseAngle[i] = Math.atan2(dy, dx);
          swirlWeight[i] = 1 / (dist + 0.35);
          depthPhase[i] = 2.0 / dist;
          vignette[i] = Math.min(1, dist * 1.4);
        }
      }

      const draw = () => {
        const swirl = parseFloat(slider.value);
        readout.textContent = swirl.toFixed(1);
        modeBtn.textContent = seamless ? labelSeamless : labelSeam;

        const data = img.data;
        const invPiHalf = 0.5 / Math.PI;

        for (let i = 0; i < count; i++) {
          const angle = baseAngle[i] + swirl * swirlWeight[i];
          const wave = seamless
            ? 0.5 + 0.5 * Math.sin(Math.cos(angle) * 3.0 + Math.sin(angle) * 2.0 + depthPhase[i])
            : ((angle * invPiHalf + 0.5) % 1 + 1) % 1;

          const v = Math.max(0, Math.min(1, wave * vignette[i]));
          const p = i * 4;
          data[p] = Math.round(v * 30);
          data[p + 1] = Math.round(v * 225);
          data[p + 2] = Math.round(v * 245);
          data[p + 3] = 255;
        }
        ctx.putImageData(img, 0, 0);
      };

      slider.addEventListener("input", draw);
      modeBtn.addEventListener("click", () => {
        seamless = !seamless;
        draw();
      });
      draw();
    });
  }
  document.addEventListener("astro:page-load", initSeamViz);
</script>