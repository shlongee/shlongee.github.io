---
import type { Lang } from "../i18n/ui";
import { resolveLang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? resolveLang(Astro.currentLocale);
const isRu = lang === "ru";

const coreLabel = isRu ? "Резкость ядра:" : "Core Sharpness:";
const haloLabel = isRu ? "Свечение ореола:" : "Halo Glow:";
---

<div class="arcane-viz bloom-viz">
  <div class="arcane-viz__controls">
    <label>
      {coreLabel} <strong class="val-core">6.5</strong>
      <input type="range" class="slider-core" min="2" max="16" step="0.5" value="6.5" />
    </label>
    <label>
      {haloLabel} <strong class="val-halo">0.58</strong>
      <input type="range" class="slider-halo" min="0" max="1" step="0.02" value="0.58" />
    </label>
  </div>
  <canvas class="arcane-viz__canvas bloom-canvas" width="520" height="140"></canvas>
</div>

<script>
  function initBloomViz() {
    document.querySelectorAll<HTMLElement>(".bloom-viz").forEach((root) => {
      if (root.dataset.vizInit) return;
      root.dataset.vizInit = "true";

      const canvas = root.querySelector<HTMLCanvasElement>(".bloom-canvas");
      const ctx = canvas?.getContext("2d");
      const sCore = root.querySelector<HTMLInputElement>(".slider-core");
      const sHalo = root.querySelector<HTMLInputElement>(".slider-halo");
      const lCore = root.querySelector<HTMLElement>(".val-core");
      const lHalo = root.querySelector<HTMLElement>(".val-halo");
      if (!canvas || !ctx || !sCore || !sHalo || !lCore || !lHalo) return;

      const radius = 34;
      const spriteSize = radius * 2 + 1;
      const stampCanvas = document.createElement("canvas");
      stampCanvas.width = spriteSize;
      stampCanvas.height = spriteSize;
      const sctx = stampCanvas.getContext("2d");
      if (!sctx) return;

      const stampImg = sctx.createImageData(spriteSize, spriteSize);
      const distTable = new Float32Array(spriteSize * spriteSize);
      for (let y = -radius, idx = 0; y <= radius; y++) {
        for (let x = -radius; x <= radius; x++, idx++) {
          distTable[idx] = Math.hypot(x, y) / radius;
        }
      }

      const draw = () => {
        const k = parseFloat(sCore.value);
        const hAmt = parseFloat(sHalo.value);
        lCore.textContent = k.toFixed(1);
        lHalo.textContent = hAmt.toFixed(2);

        const data = stampImg.data;
        for (let i = 0; i < distTable.length; i++) {
          const d = distTable[i];
          const p = i * 4;
          if (d > 1) {
            data[p + 3] = 0;
            continue;
          }
          const core = Math.exp(-d * d * k);
          const halo = Math.exp(-d * 2.4) * hAmt;
          const a = Math.min(1, (core + halo) * (1 - d * d));
          data[p] = Math.round(85 + core * 170);
          data[p + 1] = Math.round(220 + core * 35);
          data[p + 2] = 255;
          data[p + 3] = Math.round(a * 255);
        }
        sctx.putImageData(stampImg, 0, 0);

        const w = canvas.width;
        const h = canvas.height;
        ctx.fillStyle = "#060b14";
        ctx.fillRect(0, 0, w, h);

        const dots = 7;
        for (let i = 0; i < dots; i++) {
          const cx = ((i + 1) / (dots + 1)) * w;
          const cy = h / 2 + Math.sin(i * 1.1) * 14;
          ctx.drawImage(stampCanvas, cx - radius, cy - radius);
        }
      };

      sCore.addEventListener("input", draw);
      sHalo.addEventListener("input", draw);
      draw();
    });
  }
  document.addEventListener("astro:page-load", initBloomViz);
</script>