---
import type { Lang } from "../i18n/ui";
import { resolveLang, useTranslations } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<button
  type="button"
  class="arcane-btn arcane-btn--theme"
  data-theme-toggle
  aria-label={t("controls.themeAria")}
  title={t("controls.themeTitle")}
>
  <svg class="arcane-sigil" viewBox="0 0 32 32" width="22" height="22" aria-hidden="true">
    <circle class="sigil-ring" cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 2.5" />
    <!-- Solar Star (Light / Vellum) -->
    <g class="sigil-sun">
      <circle cx="16" cy="16" r="4.5" fill="currentColor" />
      <path d="M16 4v4M16 24v4M4 16h4M24 16h4M7.5 7.5l2.8 2.8M21.7 21.7l2.8 2.8M24.5 7.5l-2.8 2.8M10.3 21.7l-2.8 2.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </g>
    <!-- Astral Crescent & Sparkle (Dark / Arcane) -->
    <g class="sigil-moon">
      <path d="M19.8 8.8a7.4 7.4 0 1 0 3.4 13.3 6.2 6.2 0 0 1-3.4-13.3Z" fill="currentColor" />
      <path d="M22.5 9.5l.8 1.9 1.9.8-1.9.8-.8 1.9-.8-1.9-1.9-.8 1.9-.8z" fill="currentColor" />
    </g>
  </svg>
</button>