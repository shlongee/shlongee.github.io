---
import Navigation from "./Navigation.astro";
import Menu from "./Menu.astro";
import ArcaneControls from "./ArcaneControls.astro";
import type { Lang } from "../i18n/ui";
import { resolveLang, useTranslations } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const { lang = resolveLang(Astro.currentLocale) } = Astro.props;
const t = useTranslations(lang);
---

<header>
  <nav class="site-nav" aria-label={t("nav.aria")}>
    <div class="site-nav__bar">
      <Menu lang={lang} />
      <Navigation lang={lang} />
      <ArcaneControls showCrystal lang={lang} />
    </div>
  </nav>
</header>