---
import type { Lang } from "../i18n/ui";
import { localePath, resolveLang, useTranslations } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
const pathname = Astro.url.pathname;

const links = [
  {
    href: localePath(lang, "/"),
    label: t("nav.home"),
    match: (p: string) => (lang === "ru" ? p === "/ru/" || p === "/ru" : p === "/"),
  },
  {
    href: localePath(lang, "/blog/"),
    label: t("nav.blog"),
    match: (p: string) => p.startsWith(localePath(lang, "/blog")),
  },
  {
    href: localePath(lang, "/tags/"),
    label: t("nav.tags"),
    match: (p: string) => p.startsWith(localePath(lang, "/tags")),
  },
  {
    href: localePath(lang, "/about/"),
    label: t("nav.about"),
    match: (p: string) => p.startsWith(localePath(lang, "/about")),
  },
];
---

<div id="main-menu" class="nav-links">
  {links.map((item) => (
    <a
      href={item.href}
      class="nav-link"
      aria-current={item.match(pathname) ? "page" : undefined}
    >
      {item.label}
    </a>
  ))}
</div>