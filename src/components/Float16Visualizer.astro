---
import type { Lang } from "../i18n/ui";
import { resolveLang } from "../i18n/utils";

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? resolveLang(Astro.currentLocale);
const isRu = lang === "ru";

const labels = {
  boost: isRu ? "Сила свечения:" : "Glow Boost:",
  tail: isRu ? "Тусклый хвост:" : "Faint Tail:",
  bar8: isRu ? "8-bit LDR (фиксированный шаг 1/255)" : "8-bit LDR (1/255 fixed steps)",
  bar32: "32-bit HDR (R11G11B10_FLOAT)",
  bar64: "64-bit HDR (R16G16B16A16)",
  note: isRu
    ? "8-бит распадается на ступени, пока 64-бит (FP16) остаётся гладким"
    : "watch 8-bit turn into rings while 64-bit Float16 stays smooth.",
};
---

<div
  class="arcane-viz fp-viz"
  data-label-8bit={labels.bar8}
  data-label-32bit={labels.bar32}
  data-label-64bit={labels.bar64}
>
  <div class="arcane-viz__controls">
    <label>
      {labels.boost} <strong class="val-int">8.0x</strong>
      <input type="range" class="slider-int" min="1" max="25" step="0.5" value="8" />
    </label>
    <label>
      {labels.tail} <strong class="val-max">0.05</strong>
      <input type="range" class="slider-max" min="0.01" max="0.25" step="0.01" value="0.05" />
    </label>
  </div>
  <canvas class="arcane-viz__canvas viz-canvas" width="640" height="190"></canvas>
  <p class="arcane-viz__note">{labels.note}</p>
</div>

<script>
  function quantizeFloat(x: number, mantissaBits: number): number {
    if (x <= 0) return 0;
    const exp = Math.floor(Math.log2(x));
    if (exp < -14) {
      const step = Math.pow(2, -14 - mantissaBits);
      return Math.round(x / step) * step;
    }
    if (exp > 15) return 65504;
    const step = Math.pow(2, exp - mantissaBits);
    return Math.round(x / step) * step;
  }

  function quantize8Bit(x: number): number {
    return Math.min(1, Math.round(Math.max(0, x) * 255) / 255);
  }

  function initVisualizers() {
    document.querySelectorAll<HTMLElement>(".fp-viz").forEach((root) => {
      if (root.dataset.vizInit) return;
      root.dataset.vizInit = "true";

      const canvas = root.querySelector<HTMLCanvasElement>(".viz-canvas");
      const ctx = canvas?.getContext("2d");
      const sInt = root.querySelector<HTMLInputElement>(".slider-int");
      const sMax = root.querySelector<HTMLInputElement>(".slider-max");
      const lInt = root.querySelector<HTMLElement>(".val-int");
      const lMax = root.querySelector<HTMLElement>(".val-max");
      if (!canvas || !ctx || !sInt || !sMax || !lInt || !lMax) return;

      const formats = [
        { label: root.dataset.label8bit || "8-bit LDR (1/255 fixed steps)", fn: (v: number) => quantize8Bit(v) },
        { label: root.dataset.label32bit || "32-bit HDR (R11G11B10_FLOAT)", fn: (v: number) => quantizeFloat(v, 5) },
        { label: root.dataset.label64bit || "64-bit HDR (R16G16B16A16)", fn: (v: number) => quantizeFloat(v, 10) },
      ];

      const w = canvas.width;
      const barH = 40;
      const gap = 22;
      const barImg = ctx.createImageData(w, barH);
      const rowBytes = w * 4;

      const draw = () => {
        const intensity = parseFloat(sInt.value);
        const maxGlow = parseFloat(sMax.value);
        lInt.textContent = `${intensity.toFixed(1)}x`;
        lMax.textContent = maxGlow.toFixed(2);

        ctx.fillStyle = "#080d18";
        ctx.fillRect(0, 0, w, canvas.height);

        const data = barImg.data;
        ctx.fillStyle = "#dffaff";
        ctx.font = "12px monospace";

        formats.forEach((fmt, idx) => {
          const y = 22 + idx * (barH + gap);
          for (let px = 0; px < w; px++) {
            const q = fmt.fn((px / (w - 1)) * maxGlow);
            const t = Math.min(1, q * intensity);
            const p = px * 4;
            data[p] = Math.round(t * 95);
            data[p + 1] = Math.round(t * 240);
            data[p + 2] = Math.round(t * 255);
            data[p + 3] = 255;
          }
          for (let row = 1; row < barH; row++) {
            data.copyWithin(row * rowBytes, 0, rowBytes);
          }
          ctx.putImageData(barImg, 0, y);
          ctx.fillText(fmt.label, 8, y - 6);
        });
      };

      sInt.addEventListener("input", draw);
      sMax.addEventListener("input", draw);
      draw();
    });
  }

  document.addEventListener("astro:page-load", initVisualizers);
</script>