---
import { DEFAULT_LANG, LANGUAGES, type Lang } from "../i18n/ui";
import { getLocalePaths, localePath, resolveLang, useTranslations } from "../i18n/utils";

export interface BreadcrumbItem {
  name: string;
  path: string;
}

export interface Props {
  title: string;
  description: string;
  path?: string;
  lang?: Lang;
  alternateLocales?: Lang[];
  localePaths?: Partial<Record<Lang, string>>;
  ogType?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  rawTitle?: boolean;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  lang = resolveLang(Astro.currentLocale),
  alternateLocales = [...LANGUAGES],
  localePaths,
  ogType = "website",
  pubDate,
  updatedDate,
  tags = [],
  rawTitle = false,
  ogImage,
  breadcrumbs = [],
} = Astro.props;

const t = useTranslations(lang);
const clean = (s: string) => s.replace(/\s+/g, " ").trim();
const cleanTitle = clean(title);
const cleanDescription = clean(description);

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://shlongee.github.io";
const canonical = new URL(path, `${siteUrl}/`).toString();
const fullTitle = rawTitle ? cleanTitle : `${cleanTitle} — Shlongeeland`;
const imageUrl = ogImage ? new URL(ogImage, `${siteUrl}/`).toString() : undefined;

const allPaths = getLocalePaths(path, localePaths);
const alternates = alternateLocales.map((altLang) => ({
  lang: altLang,
  href: new URL(allPaths[altLang], `${siteUrl}/`).toString(),
}));

const xDefaultHref =
  alternates.find((a) => a.lang === DEFAULT_LANG)?.href ?? canonical;

const rssLinks = LANGUAGES.map((l) => ({
  lang: l,
  href: new URL(localePath(l, "/rss.xml"), `${siteUrl}/`).toString(),
}));

const schemaGraph: Record<string, unknown>[] = [
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    url: `${siteUrl}/`,
    name: "Shlongeeland",
    inLanguage: lang,
    description: t("site.seoDesc"),
    potentialAction: {
      "@type": "SearchAction",
      target: `${siteUrl}${localePath(lang, "/blog/")}?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@type": "Person",
    "@id": `${siteUrl}/#author`,
    name: "Shlongee",
    url: `${siteUrl}${localePath(lang, "/about/")}`,
    sameAs: ["https://github.com/shlongee"],
  },
];

if (ogType === "article" && pubDate) {
  schemaGraph.push({
    "@type": "BlogPosting",
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    headline: cleanTitle,
    description: cleanDescription,
    inLanguage: lang,
    datePublished: pubDate.toISOString(),
    ...(updatedDate && { dateModified: updatedDate.toISOString() }),
    author: { "@id": `${siteUrl}/#author` },
    publisher: { "@id": `${siteUrl}/#website` },
    ...(tags.length > 0 && { keywords: tags.join(", ") }),
    ...(imageUrl && { image: imageUrl }),
  });
}

if (breadcrumbs.length > 0) {
  schemaGraph.push({
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: clean(crumb.name),
      item: new URL(crumb.path, `${siteUrl}/`).toString(),
    })),
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": schemaGraph,
};
---

<title>{fullTitle}</title>
<meta name="description" content={cleanDescription} />
<meta name="author" content="Shlongee" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<meta property="og:type" content={ogType} />
<meta property="og:locale" content={lang === "ru" ? "ru_RU" : "en_US"} />
{LANGUAGES.filter((l) => l !== lang).map((alt) => (
  <meta property="og:locale:alternate" content={alt === "ru" ? "ru_RU" : "en_US"} />
))}
<meta property="og:site_name" content="Shlongeeland" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={cleanDescription} />
<meta property="og:url" content={canonical} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={cleanDescription} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

<link rel="canonical" href={canonical} />
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.lang} href={alt.href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
{rssLinks.map((feed) => (
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`Shlongeeland (${feed.lang.toUpperCase()}) RSS`}
    href={feed.href}
  />
))}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />