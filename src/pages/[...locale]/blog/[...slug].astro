---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BlogPostLayout from "../../../layouts/BlogPostLayout.astro";
import { DEFAULT_LANG, LANGUAGES, type Lang } from "../../../i18n/ui";
import { localePath, splitPostId } from "../../../i18n/utils";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog", ({ data }) => !data.draft);

  const slugsByLang = Object.fromEntries(
    LANGUAGES.map((lang) => [lang, new Set<string>()]),
  ) as Record<Lang, Set<string>>;

  for (const post of allPosts) {
    const { lang, slug } = splitPostId(post.id);
    slugsByLang[lang].add(slug);
  }

  return allPosts.map((post) => {
    const { lang, slug } = splitPostId(post.id);
    const localePaths = {} as Record<Lang, string>;
    const alternateLocales: Lang[] = [];

    for (const targetLang of LANGUAGES) {
      const hasTranslation = slugsByLang[targetLang].has(slug);
      localePaths[targetLang] = hasTranslation
        ? localePath(targetLang, `/blog/${slug}/`)
        : localePath(targetLang, "/blog/");
      if (hasTranslation) alternateLocales.push(targetLang);
    }

    return {
      params: {
        locale: lang === DEFAULT_LANG ? undefined : lang,
        slug,
      },
      props: {
        post,
        lang,
        localePaths,
        alternateLocales,
      },
    };
  });
}

interface Props {
  post: CollectionEntry<"blog">;
  lang: Lang;
  localePaths: Partial<Record<Lang, string>>;
  alternateLocales: Lang[];
}

const { post, lang, localePaths, alternateLocales } = Astro.props;
const { Content } = await render(post);
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  ogImage={post.data.ogImage}
  lang={lang}
  localePaths={localePaths}
  alternateLocales={alternateLocales}
>
  <Content />
</BlogPostLayout>