---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogSearch from "../../components/BlogSearch";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const initialPosts = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate.toISOString(),
  tags: post.data.tags,
}));

const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags)),
).sort((a, b) => a.localeCompare(b));

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
];
---

<BaseLayout
  title="Shader & Graphics Devlog"
  description="Practical notes on GLSL shaders, Raylib HDR bloom, Three.js WebGL effects, and graphics bugs turned into clear mental models."
  breadcrumbs={breadcrumbs}
>
  <h1>The Shader Spellbook</h1>
  <p class="page-lede">
    Dev reports on GLSL shaders, real-time rendering, WebGL experiments, and hard-won bug fixes.
  </p>
  <BlogSearch client:load initialPosts={initialPosts} allTags={allTags} />
</BaseLayout>