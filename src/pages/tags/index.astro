---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = Array.from(counts.entries()).sort((a, b) => a[0].localeCompare(b[0]));

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Tags", path: "/tags/" },
];
---

<BaseLayout
  title="Topics & Shader Tags"
  description="Explore Shlongeeland dev reports by topic: GLSL, HDR bloom, Raylib, Three.js, WebGL shaders, and Astro architecture."
  breadcrumbs={breadcrumbs}
>
  <h1>Topics &amp; Shader Tags</h1>
  <p class="page-lede">Pick a topic to filter dev reports by shader, rendering, or web engineering cluster.</p>
  <ul class="tag-grid">
    {tags.map(([tag, count]) => (
      <li>
        <a class="tag-pill" href={`/tags/${encodeURIComponent(tag)}/`}>
          #{tag} <span>({count})</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>